{
  "name": "signature-detailing-crm",
  "version": "1.0.0",
  "description": "Next-Generation CRM & Automation Platform for Signature Detailing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node backend/src/server.js",
    "dev:all": "npm run dev --prefix backend & npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "vercel-build": "cd frontend && npm install && npm run build",
    "test": "node backend/tests/system_verification.mjs",
    "test": "node backend/tests/system_verification.mjs && node tests/ui_verification.mjs",
    "test:backend": "node backend/tests/system_verification.mjs",
    "test:ui": "node tests/ui_verification.mjs",
    "start": "node backend/src/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.24.2"
  },
  "keywords": [
    "crm",
    "signature-detailing",
    "whatsapp",
    "instagram",
    "lead-automation"
  ],
  "author": "Signature Detailing",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
